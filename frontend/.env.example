# For local frontend development (Vite server running on 5173, backend on 8002)
# Copy this file to .env.local for local overrides
VITE_API_URL=http://localhost:8002

# For production (Vercel)
# Do NOT put the production URL here.
# Add VITE_API_URL directly in the Vercel Project Settings > Environment Variables
# Example: VITE_API_URL=https://merchant-maxx-api-1066165000716.us-central1.run.app
