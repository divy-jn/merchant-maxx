# === LLM Provider ===
# Current Routing Priority:
# 1. Gemini 3.7 Flash
# 2. Gemini 3.6 Flash
# 3. Gemini 3.5 Flash
# 4. OpenRouter Nemotron :free
LLM_PRIMARY_PROVIDER=gemini
LLM_PRIMARY_MODEL=gemini-3.7-flash
LLM_FALLBACK_PROVIDERS=openrouter
ALLOW_PAID_LLM=false

LLM_API_KEY=
OPENROUTER_API_KEY=

# === Razorpay (Test Mode) ===
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# === Supabase ===
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
DATABASE_URL=

# === Redis ===
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# === Pinecone ===
PINECONE_API_KEY=

# === Guardian Config ===
GUARDIAN_MAX_TRANSACTION_PAISE=1000000
GUARDIAN_DAILY_BUDGET_PAISE=5000000
GUARDIAN_REQUIRE_CONFIRMATION=true

# === App ===
APP_ENV=development
CORS_ORIGINS=http://localhost:5173
