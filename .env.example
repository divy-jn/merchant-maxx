# Merchant MAXX — Environment Template
# Never commit real credentials. Use local .env files or managed deployment secrets.

# === LLM ===
# Set one active provider. Supported providers in backend/config.py: openai or gemini.
LLM_PROVIDER=openai

# OpenAI
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_TEMPERATURE=0.0
OPENAI_MAX_RETRIES=0
OPENAI_TIMEOUT=30

# Gemini
GEMINI_MODEL=gemini-3.7-flash
GEMINI_API_KEY=
GEMINI_TEMPERATURE=0.0
GEMINI_MAX_RETRIES=0
GEMINI_TIMEOUT=30

# === Razorpay (Test Mode) ===
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# === Supabase ===
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
DATABASE_URL=

# === Pinecone ===
PINECONE_API_KEY=

# === Guardian ===
GUARDIAN_MAX_TRANSACTION_PAISE=1000000
GUARDIAN_DAILY_BUDGET_PAISE=5000000
GUARDIAN_REQUIRE_CONFIRMATION=true

# === App ===
APP_ENV=development
CORS_ORIGINS=http://localhost:5173
JWT_SECRET=
JWT_EXPIRY_HOURS=24
